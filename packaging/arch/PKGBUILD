# Maintainer: Jacques HULLU <jacquesh82 at users dot noreply dot github dot com>
#
# PKGBUILD de l'AUR (https://aur.archlinux.org/packages/hyprdesk) : construit
# depuis l'archive du tag v$pkgver, selon les Arch package guidelines et les
# Rust package guidelines. Le paquet binaire de scripts/package.sh (nfpm) en
# est la version précompilée, pour qui ne veut pas construire.

pkgname=hyprdesk
pkgver=0.1.1
pkgrel=1
pkgdesc='Desktop for Hyprland: bar, launcher, lock, per-workspace wallpapers and widgets'
arch=('x86_64')
url='https://github.com/jacquesh82/hyprdesk'
# MIT pour le code, OFL-1.1 pour la police Mindlog embarquée.
license=('MIT AND OFL-1.1')
# Relevé de scripts/package.sh : liées (glibc, libgcc, PAM), chargées à
# l'exécution (Wayland, xkbcommon, Vulkan, EGL), programmes appelés.
depends=(
  'fontconfig'
  'glibc'
  'hyprland'
  'libgcc'
  'libglvnd'
  'libxkbcommon'
  'pam'
  'systemd'
  'tar'
  'vulkan-icd-loader'
  'wayland'
  'xdg-utils'
)
makedepends=('cargo')
# Installation minimale : l'écran de connexion (greetd, cage), le trousseau et
# l'assistante restent des choix explicites. Descriptions en anglais : c'est
# ce que la page AUR et pacman -Si affichent.
optdepends=(
  'greetd: hyprdesk login screen (hyprdesk greeter setup)'
  'cage: hyprdesk login screen (kiosk compositor for the greeter)'
  'hypridle: idle and automatic lock'
  'wireplumber: sound (wpctl)'
  'wl-clipboard: copy and paste (wl-copy, wl-paste)'
  'libnotify: notifications for screenshots, battery and LYRA (notify-send)'
  'xdg-user-dirs: Pictures and Videos folders for screenshots (xdg-user-dir)'
  'networkmanager: network (nmcli)'
  'nm-connection-editor: advanced network settings'
  'bluez-utils: Bluetooth (bluetoothctl)'
  'blueman: advanced Bluetooth settings'
  'brightnessctl: dim the screen when idle'
  'power-profiles-daemon: power profiles'
  'polkit: administrator authentication, updates (pkexec)'
  'glib2: desktop trash (gio)'
  'util-linux: airplane mode (rfkill), removable drives (lsblk)'
  'pacman-contrib: pending updates (checkupdates)'
  'curl: AI services, SmartUI design, sample weather widget'
  'libsecret: AI services, API keys in the keyring (secret-tool)'
  'flatpak: Flatpak application updates'
  'xdg-desktop-portal-hyprland: screen sharing'
  'xdg-desktop-portal-gtk: file picker'
  'hyprshot: screenshots'
  'wf-recorder: screen recording'
  'cliphist: clipboard history'
  'hyprsunset: night light'
  'udisks2: removable drives (mount, eject)'
  'ddcutil: external screen brightness (DDC/CI)'
  'slurp: screenshot or recording of an area'
  'wvkbd: on-screen keyboard'
  'fprintd: fingerprint at the lock screen'
  'pavucontrol: advanced sound settings'
  'unzip: .zip themes'
  'git: plugins from a git repository'
  'kitty: application theme (terminal)'
  'wayle: notifications through wayle (AUR; without it, hyprdesk shows them)'
)
# Sans LTO : le -flto=auto de makepkg fait de la Lua compilée par mlua (C)
# du bitcode GCC que rust-lld ne lit pas (undefined symbol: lua_rotate…).
options=('!lto')
install=hyprdesk.install
source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz")
# Renseigné par la CI au moment du tag (job release de ci.yml) : hash du
# tarball GitHub, committé sur main. 'SKIP' en attendant.
sha256sums=('c7f9a4ab40debe385b651c7603a596e6e7ee7b1fe890a15ffe9f50dd8eaf9a80')

prepare() {
  cd "$pkgname-$pkgver"
  export RUSTUP_TOOLCHAIN=stable
  cargo fetch --locked --target "$(rustc --print host-tuple)"
}

build() {
  cd "$pkgname-$pkgver"
  export RUSTUP_TOOLCHAIN=stable
  export CARGO_TARGET_DIR=target
  cargo build --frozen --release
}

check() {
  cd "$pkgname-$pkgver"
  export RUSTUP_TOOLCHAIN=stable
  export CARGO_TARGET_DIR=target
  cargo test --frozen --release
}

package() {
  cd "$pkgname-$pkgver"
  install -Dm0755 -t "$pkgdir/usr/bin/" "target/release/$pkgname"

  # Unit systemd utilisateur : celle du dépôt vise ~/.local/bin (scripts/install.sh).
  sed -e 's#%h/\.local/bin/hyprdesk#/usr/bin/hyprdesk#' \
      -e 's#déposée par scripts/install.sh#installée par le paquet hyprdesk#' \
      -e 's#(qui précise WAYLAND_DISPLAY détecté)\.#(environnement de session : systemctl --user import-environment).#' \
      assets/hyprdesk.service > hyprdesk.service
  grep -q '^ExecStart=/usr/bin/hyprdesk ' hyprdesk.service
  install -Dm0644 -t "$pkgdir/usr/lib/systemd/user/" hyprdesk.service

  install -Dm0644 -t "$pkgdir/usr/share/fonts/$pkgname/Mindlog/" assets/fonts/mindlog/*.ttf
  install -Dm0644 -t "$pkgdir/usr/share/doc/$pkgname/" \
    README.md README.fr.md docs/PLUGINS.md docs/PLUGINS.en.md
  install -Dm0644 -t "$pkgdir/usr/share/licenses/$pkgname/" LICENSE
  install -Dm0644 assets/fonts/mindlog/OFL.txt "$pkgdir/usr/share/licenses/$pkgname/OFL-Mindlog.txt"
}

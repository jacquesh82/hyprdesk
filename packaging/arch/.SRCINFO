pkgbase = hyprdesk
	pkgdesc = Desktop for Hyprland: bar, launcher, lock, per-workspace wallpapers and widgets
	pkgver = 0.1.0
	pkgrel = 1
	url = https://github.com/jacquesh82/hyprdesk
	install = hyprdesk.install
	arch = x86_64
	license = MIT AND OFL-1.1
	makedepends = cargo
	depends = fontconfig
	depends = glibc
	depends = hyprland
	depends = libgcc
	depends = libglvnd
	depends = libxkbcommon
	depends = pam
	depends = systemd
	depends = tar
	depends = vulkan-icd-loader
	depends = wayland
	depends = xdg-utils
	optdepends = greetd: hyprdesk login screen (hyprdesk greeter setup)
	optdepends = cage: hyprdesk login screen (kiosk compositor for the greeter)
	optdepends = hypridle: idle and automatic lock
	optdepends = wireplumber: sound (wpctl)
	optdepends = wl-clipboard: copy and paste (wl-copy, wl-paste)
	optdepends = libnotify: notifications for screenshots, battery and LYRA (notify-send)
	optdepends = xdg-user-dirs: Pictures and Videos folders for screenshots (xdg-user-dir)
	optdepends = networkmanager: network (nmcli)
	optdepends = nm-connection-editor: advanced network settings
	optdepends = bluez-utils: Bluetooth (bluetoothctl)
	optdepends = blueman: advanced Bluetooth settings
	optdepends = brightnessctl: dim the screen when idle
	optdepends = power-profiles-daemon: power profiles
	optdepends = polkit: administrator authentication, updates (pkexec)
	optdepends = glib2: desktop trash (gio)
	optdepends = util-linux: airplane mode (rfkill), removable drives (lsblk)
	optdepends = pacman-contrib: pending updates (checkupdates)
	optdepends = curl: AI services, SmartUI design, sample weather widget
	optdepends = libsecret: AI services, API keys in the keyring (secret-tool)
	optdepends = flatpak: Flatpak application updates
	optdepends = xdg-desktop-portal-hyprland: screen sharing
	optdepends = xdg-desktop-portal-gtk: file picker
	optdepends = hyprshot: screenshots
	optdepends = wf-recorder: screen recording
	optdepends = cliphist: clipboard history
	optdepends = hyprsunset: night light
	optdepends = udisks2: removable drives (mount, eject)
	optdepends = ddcutil: external screen brightness (DDC/CI)
	optdepends = slurp: screenshot or recording of an area
	optdepends = wvkbd: on-screen keyboard
	optdepends = fprintd: fingerprint at the lock screen
	optdepends = pavucontrol: advanced sound settings
	optdepends = unzip: .zip themes
	optdepends = git: plugins from a git repository
	optdepends = kitty: application theme (terminal)
	optdepends = wayle: notifications through wayle (AUR; without it, hyprdesk shows them)
	options = !lto
	source = hyprdesk-0.1.0.tar.gz::https://github.com/jacquesh82/hyprdesk/archive/refs/tags/v0.1.0.tar.gz
	sha256sums = c7f9a4ab40debe385b651c7603a596e6e7ee7b1fe890a15ffe9f50dd8eaf9a80

pkgname = hyprdesk

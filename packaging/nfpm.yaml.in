# Paquets de hyprdesk (deb, rpm, archlinux) — gabarit lu par scripts/package.sh,
# qui en remplace les marqueurs (@…@) puis lance nfpm. Ne pas lancer nfpm sur ce fichier.
name: hyprdesk
arch: "@ARCH@"
platform: linux
version: "@VERSION@"
release: "@RELEASE@"
section: x11
priority: optional
maintainer: "@MAINTAINER@"
description: |
  Bureau à la demande pour Hyprland : fond d'écran, icônes et widgets par
  workspace, barre, lanceur, verrouillage, configuré en Lua.
vendor: LeLab
homepage: https://github.com/jacquesh82/hyprdesk
license: MIT

contents:
  - src: "@STAGE@/usr/bin/hyprdesk"
    dst: /usr/bin/hyprdesk
    file_info:
      mode: 0755
  # Unit systemd utilisateur : ExecStart sur /usr/bin (la version de
  # scripts/install.sh vise ~/.local/bin).
  - src: "@STAGE@/usr/lib/systemd/user/hyprdesk.service"
    dst: /usr/lib/systemd/user/hyprdesk.service
    file_info:
      mode: 0644
  # Police Mindlog (OFL), utilisée par l'interface.
  - src: assets/fonts/mindlog/*.ttf
    dst: /usr/share/fonts/hyprdesk/Mindlog/
    file_info:
      mode: 0644
  - src: assets/fonts/mindlog/OFL.txt
    dst: /usr/share/licenses/hyprdesk/OFL-Mindlog.txt
    file_info:
      mode: 0644
  - src: LICENSE
    dst: /usr/share/licenses/hyprdesk/LICENSE
    file_info:
      mode: 0644
  - src: README.md
    dst: /usr/share/doc/hyprdesk/README.md
    file_info:
      mode: 0644
  - src: README.fr.md
    dst: /usr/share/doc/hyprdesk/README.fr.md
    file_info:
      mode: 0644
  - src: docs/PLUGINS.md
    dst: /usr/share/doc/hyprdesk/PLUGINS.md
    file_info:
      mode: 0644
  - src: docs/PLUGINS.en.md
    dst: /usr/share/doc/hyprdesk/PLUGINS.en.md
    file_info:
      mode: 0644

scripts:
  postinstall: packaging/postinstall.sh

# Relevé du binaire et du code (scripts/package.sh n'invente rien) :
# - liées : glibc, PAM (verrouillage), libgcc ;
# - chargées à l'exécution : Wayland, xkbcommon, Vulkan, et EGL + wayland-egl
#   (rendu de secours sans pilote Vulkan) ; X11 seulement hors Wayland, non requis ;
# - programmes : xdg-mime / xdg-open (applications par défaut, ouverture des
#   fichiers), tar (partage, thèmes), systemctl / loginctl / timedatectl
#   (session, veille, date), fc-list (polices) ; wl-copy / wl-paste
#   (copier-coller) ; notify-send (notifications des captures, de la batterie,
#   de LYRA) ; xdg-user-dir (dossiers Images et Vidéos des captures) ;
#   greetd et cage (écran de connexion, Réglages → Écran de connexion : le
#   paquet les installe, la bascule depuis GDM reste un choix explicite) ;
# - facultatifs : les outils orchestrés (hyprdesk doctor, Réglages → Bureau →
#   Dépendances) et les renvois des menus : gio (corbeille), rfkill (mode
#   avion), pkexec (mises à jour), checkupdates / flatpak (mises à jour).
# Le binaire ne lie que glibc, libgcc et PAM (objdump -p : NEEDED).
overrides:
  deb:
    depends:
      - "libc6 (>= @GLIBC@)"
      - libgcc-s1
      - libpam0g
      - libwayland-client0
      - libwayland-egl1
      - libxkbcommon0
      - libvulkan1
      - libegl1
      - xdg-utils
      - systemd
      - fontconfig
      - greetd
      - cage
    recommends:
      - hyprland
      - hypridle
      - wireplumber
      - wl-clipboard
      - libnotify-bin
      - xdg-user-dirs
      - mesa-vulkan-drivers
    suggests:
      - network-manager
      - network-manager-gnome
      - bluez
      - blueman
      - brightnessctl
      - power-profiles-daemon
      - polkitd
      - pkexec
      - libglib2.0-bin
      - rfkill
      - flatpak
      - xdg-desktop-portal-hyprland
      - xdg-desktop-portal-gtk
      - hyprshot
      - wf-recorder
      - cliphist
      - hyprsunset
      - udisks2
      - ddcutil
      - slurp
      - wvkbd
      - fprintd
      - pavucontrol
      - unzip
      - git
      - curl
      - kitty
  rpm:
    depends:
      - "glibc >= @GLIBC@"
      - libgcc
      - pam
      - libwayland-client
      - libwayland-egl
      - libxkbcommon
      - vulkan-loader
      - libglvnd-egl
      - xdg-utils
      - tar
      - systemd
      - fontconfig
      - greetd
      - cage
    recommends:
      - hyprland
      - hypridle
      - wireplumber
      - wl-clipboard
      - libnotify
      - xdg-user-dirs
      - mesa-vulkan-drivers
    suggests:
      - NetworkManager
      - nm-connection-editor
      - bluez
      - blueman
      - brightnessctl
      - power-profiles-daemon
      - polkit
      - glib2
      - util-linux
      - flatpak
      - xdg-desktop-portal-hyprland
      - xdg-desktop-portal-gtk
      - hyprshot
      - wf-recorder
      - cliphist
      - hyprsunset
      - udisks2
      - ddcutil
      - slurp
      - wvkbd
      - fprintd
      - pavucontrol
      - unzip
      - git
      - curl
      - kitty
  archlinux:
    depends:
      - "glibc>=@GLIBC@"
      - gcc-libs
      - pam
      - wayland
      - libxkbcommon
      - vulkan-icd-loader
      - libglvnd
      - xdg-utils
      - tar
      - systemd
      - fontconfig
      - hyprland
      - greetd
      - cage
    # optdepends : « paquet: raison ».
    suggests:
      - "hypridle: veille et verrouillage automatique"
      - "wireplumber: son (wpctl)"
      - "wl-clipboard: copier-coller (wl-copy, wl-paste)"
      - "libnotify: notifications des captures, de la batterie, de LYRA (notify-send)"
      - "xdg-user-dirs: dossiers Images et Vidéos des captures (xdg-user-dir)"
      - "networkmanager: réseau (nmcli)"
      - "nm-connection-editor: réglages réseau avancés"
      - "bluez-utils: Bluetooth (bluetoothctl)"
      - "blueman: réglages Bluetooth avancés"
      - "brightnessctl: assombrir l'écran à l'inactivité"
      - "power-profiles-daemon: profils d'énergie"
      - "polkit: authentification administrateur, mises à jour (pkexec)"
      - "glib2: corbeille du bureau (gio)"
      - "util-linux: mode avion (rfkill), supports amovibles (lsblk)"
      - "pacman-contrib: paquets à mettre à jour (checkupdates)"
      - "flatpak: mises à jour des applications Flatpak"
      - "xdg-desktop-portal-hyprland: partage d'écran"
      - "xdg-desktop-portal-gtk: sélecteur de fichiers"
      - "hyprshot: captures d'écran"
      - "wf-recorder: enregistrement de l'écran"
      - "cliphist: historique du presse-papiers"
      - "hyprsunset: éclairage nocturne"
      - "udisks2: supports amovibles (montage, éjection)"
      - "ddcutil: luminosité des écrans externes (DDC/CI)"
      - "slurp: capture ou enregistrement d'une zone"
      - "wvkbd: clavier virtuel"
      - "fprintd: empreinte digitale au verrouillage"
      - "pavucontrol: réglages du son avancés"
      - "unzip: thèmes au format .zip"
      - "git: plugins depuis un dépôt git"
      - "curl: widget météo d'exemple (hyprdesk.lua)"
      - "kitty: thème des applications (terminal)"
      - "wayle: notifications par wayle (sans lui, hyprdesk les affiche)"

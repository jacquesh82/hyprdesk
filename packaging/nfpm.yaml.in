# Paquets de hyprdesk (deb, rpm, archlinux) — gabarit lu par scripts/package.sh,
# qui en remplace les marqueurs (@…@) puis lance nfpm. Ne pas lancer nfpm sur ce fichier.
name: hyprdesk
arch: "@ARCH@"
platform: linux
version: "@VERSION@"
release: "@RELEASE@"
section: x11
priority: optional
maintainer: "@MAINTAINER@"
description: |
  Bureau à la demande pour Hyprland : fond d'écran, icônes et widgets par
  workspace, barre, lanceur, verrouillage, configuré en Lua.
vendor: hyprdesk
homepage: https://github.com/jacquesh82/hyprdesk
# GPL-3.0-or-later pour le code, OFL-1.1 pour la police Mindlog embarquée (SPDX).
license: GPL-3.0-or-later AND OFL-1.1

contents:
  - src: "@STAGE@/usr/bin/hyprdesk"
    dst: /usr/bin/hyprdesk
    file_info:
      mode: 0755
  # Binaires dédiés : écran de verrouillage, écran de connexion, agent polkit.
  - src: "@STAGE@/usr/bin/hyprdesk-lock"
    dst: /usr/bin/hyprdesk-lock
    file_info:
      mode: 0755
  - src: "@STAGE@/usr/bin/hyprdesk-greeter"
    dst: /usr/bin/hyprdesk-greeter
    file_info:
      mode: 0755
  - src: "@STAGE@/usr/bin/hyprdesk-polkit"
    dst: /usr/bin/hyprdesk-polkit
    file_info:
      mode: 0755
  # Moteur de thème en ligne de commande (MLG-230).
  - src: "@STAGE@/usr/bin/hyprdesk-theme-engine"
    dst: /usr/bin/hyprdesk-theme-engine
    file_info:
      mode: 0755
  # Unit systemd utilisateur : ExecStart sur /usr/bin (la version de
  # scripts/install.sh vise ~/.local/bin).
  - src: "@STAGE@/usr/lib/systemd/user/hyprdesk.service"
    dst: /usr/lib/systemd/user/hyprdesk.service
    file_info:
      mode: 0644
  # Pile PAM du verrouillage (MLG-153) : /etc/pam.d/hyprdesk-lock, fichier de
  # configuration gardé s'il a été modifié. deb : common-auth ; archlinux :
  # system-auth ; rpm (Fedora : system-auth, openSUSE : common-auth) : choisi
  # par packaging/postinstall.sh d'après la distribution, depuis les modèles
  # de /usr/share/hyprdesk/pam/.
  - src: packaging/pam/hyprdesk-lock.common-auth
    dst: /etc/pam.d/hyprdesk-lock
    type: config|noreplace
    packager: deb
    file_info:
      mode: 0644
  - src: packaging/pam/hyprdesk-lock.system-auth
    dst: /etc/pam.d/hyprdesk-lock
    type: config|noreplace
    packager: archlinux
    file_info:
      mode: 0644
  - src: packaging/pam/hyprdesk-lock.system-auth
    dst: /usr/share/hyprdesk/pam/hyprdesk-lock.system-auth
    file_info:
      mode: 0644
  - src: packaging/pam/hyprdesk-lock.common-auth
    dst: /usr/share/hyprdesk/pam/hyprdesk-lock.common-auth
    file_info:
      mode: 0644
  # Police Mindlog (OFL), utilisée par l'interface.
  - src: assets/fonts/mindlog/*.ttf
    dst: /usr/share/fonts/hyprdesk/Mindlog/
    file_info:
      mode: 0644
  # Vidéo du fond livré de l'écran de connexion (lisible sans pose).
  - src: assets/greeter/fond.mp4
    dst: /usr/share/hyprdesk/greeter/fond.mp4
    file_info:
      mode: 0644
  - src: assets/fonts/mindlog/OFL.txt
    dst: /usr/share/licenses/hyprdesk/OFL-Mindlog.txt
    file_info:
      mode: 0644
  - src: LICENSE
    dst: /usr/share/licenses/hyprdesk/LICENSE
    file_info:
      mode: 0644
  - src: README.md
    dst: /usr/share/doc/hyprdesk/README.md
    file_info:
      mode: 0644
  - src: README.fr.md
    dst: /usr/share/doc/hyprdesk/README.fr.md
    file_info:
      mode: 0644
  - src: docs/PLUGINS.md
    dst: /usr/share/doc/hyprdesk/PLUGINS.md
    file_info:
      mode: 0644
  - src: docs/PLUGINS.en.md
    dst: /usr/share/doc/hyprdesk/PLUGINS.en.md
    file_info:
      mode: 0644

scripts:
  postinstall: packaging/postinstall.sh

# Signature des paquets (MLG-151) : demande une clé privée, à fournir en
# secret de la CI (jamais dans le dépôt). En attendant, l'intégrité passe
# par SHA256SUMS signé par cosign (job release de ci.yml), vérifié par
# scripts/release.sh avant l'installation. Pour l'activer : une clé GPG
# dédiée, NFPM_PASSPHRASE et le chemin de la clé dans l'environnement du job
# packages, puis décommenter :
# deb:
#   signature:
#     key_file: ${NFPM_SIGNING_KEY_FILE}
# rpm:
#   signature:
#     key_file: ${NFPM_SIGNING_KEY_FILE}
# (archlinux : signature détachée .sig par gpg --detach-sign, hors nfpm.)

# Arch : packager inscrit dans .PKGINFO (sinon « Unknown Packager »).
archlinux:
  packager: "@MAINTAINER@"

# Relevé du binaire et du code (scripts/package.sh n'invente rien) :
# - liées : glibc, PAM (verrouillage), libgcc ;
# - chargées à l'exécution : Wayland, xkbcommon, Vulkan, et EGL + wayland-egl
#   (rendu de secours sans pilote Vulkan) ; X11 seulement hors Wayland, non requis ;
# - programmes : xdg-mime / xdg-open (applications par défaut, ouverture des
#   fichiers), tar (partage, thèmes), systemctl / loginctl / timedatectl
#   (session, veille, date), fc-list (polices) ; wl-copy / wl-paste
#   (copier-coller) ; notify-send (notifications des captures, de la batterie,
#   de LYRA) ; xdg-user-dir (dossiers Images et Vidéos des captures) ;
#   greetd et cage (écran de connexion, Réglages → Écran de connexion) :
#   suggérés seulement, l'écran de connexion reste un choix explicite ;
# - facultatifs : les outils orchestrés (hyprdesk doctor, Réglages → Bureau →
#   Dépendances) et les renvois des menus : gio (corbeille), rfkill (mode
#   avion), pkexec (mises à jour), checkupdates / flatpak (mises à jour).
# Le binaire ne lie que glibc, libgcc et PAM (objdump -p : NEEDED).
overrides:
  deb:
    depends:
      - "libc6 (>= @GLIBC@)"
      - libgcc-s1
      - libpam0g
      - libwayland-client0
      - libwayland-egl1
      - libxkbcommon0
      - libvulkan1
      - libegl1
      - xdg-utils
      - systemd
      - fontconfig
    recommends:
      - hyprland
      - hypridle
      - wireplumber
      - wl-clipboard
      - libnotify-bin
      - xdg-user-dirs
      - mesa-vulkan-drivers
    suggests:
      - greetd
      - cage
      - ffmpeg
      - network-manager
      - network-manager-gnome
      - bluez
      - blueman
      - brightnessctl
      - power-profiles-daemon
      - polkitd
      - pkexec
      - libglib2.0-bin
      - rfkill
      - flatpak
      - xdg-desktop-portal-hyprland
      - xdg-desktop-portal-gtk
      - hyprshot
      - wf-recorder
      - cliphist
      - hyprsunset
      - udisks2
      - ddcutil
      - slurp
      - wvkbd
      - fprintd
      - pavucontrol
      - unzip
      - git
      - curl
      - kitty
  rpm:
    depends:
      - "glibc >= @GLIBC@"
      - libgcc
      - pam
      - libwayland-client
      - libwayland-egl
      - libxkbcommon
      - vulkan-loader
      - libglvnd-egl
      - xdg-utils
      - tar
      - systemd
      - fontconfig
    recommends:
      - hyprland
      - hypridle
      - wireplumber
      - wl-clipboard
      - libnotify
      - xdg-user-dirs
      - mesa-vulkan-drivers
    suggests:
      - greetd
      - cage
      - ffmpeg
      - NetworkManager
      - nm-connection-editor
      - bluez
      - blueman
      - brightnessctl
      - power-profiles-daemon
      - polkit
      - glib2
      - util-linux
      - flatpak
      - xdg-desktop-portal-hyprland
      - xdg-desktop-portal-gtk
      - hyprshot
      - wf-recorder
      - cliphist
      - hyprsunset
      - udisks2
      - ddcutil
      - slurp
      - wvkbd
      - fprintd
      - pavucontrol
      - unzip
      - git
      - curl
      - kitty
  archlinux:
    # Sous Arch, fc-cache est lancé par le hook de fontconfig : pas de
    # postinstall qui le refasse (Arch package guidelines).
    scripts:
      postinstall: packaging/arch/postinstall.sh
    depends:
      - "glibc>=@GLIBC@"
      # gcc-libs est devenu un méta-paquet (Fortran, sanitizers…) : seul
      # libgcc_s est lié.
      - libgcc
      - pam
      - wayland
      - libxkbcommon
      - vulkan-icd-loader
      - libglvnd
      - xdg-utils
      - tar
      - systemd
      - fontconfig
      - hyprland
    # optdepends : « paquet: raison ».
    suggests:
      - "greetd: écran de connexion de hyprdesk (hyprdesk greeter setup)"
      - "cage: écran de connexion de hyprdesk (compositeur du greeter)"
      - "ffmpeg: fonds d'écran vidéo (dont celui de l'écran de connexion)"
      - "hypridle: veille et verrouillage automatique"
      - "wireplumber: son (wpctl)"
      - "wl-clipboard: copier-coller (wl-copy, wl-paste)"
      - "libnotify: notifications des captures, de la batterie, de LYRA (notify-send)"
      - "xdg-user-dirs: dossiers Images et Vidéos des captures (xdg-user-dir)"
      - "networkmanager: réseau (nmcli)"
      - "nm-connection-editor: réglages réseau avancés"
      - "curl: services IA, SmartUI design (appels aux API)"
      - "libsecret: services IA, clés API dans le trousseau (secret-tool)"
      - "bluez-utils: Bluetooth (bluetoothctl)"
      - "blueman: réglages Bluetooth avancés"
      - "brightnessctl: assombrir l'écran à l'inactivité"
      - "power-profiles-daemon: profils d'énergie"
      - "polkit: authentification administrateur, mises à jour (pkexec)"
      - "glib2: corbeille du bureau (gio)"
      - "util-linux: mode avion (rfkill), supports amovibles (lsblk)"
      - "pacman-contrib: paquets à mettre à jour (checkupdates)"
      - "flatpak: mises à jour des applications Flatpak"
      - "xdg-desktop-portal-hyprland: partage d'écran"
      - "xdg-desktop-portal-gtk: sélecteur de fichiers"
      - "hyprshot: captures d'écran"
      - "wf-recorder: enregistrement de l'écran"
      - "cliphist: historique du presse-papiers"
      - "hyprsunset: éclairage nocturne"
      - "udisks2: supports amovibles (montage, éjection)"
      - "ddcutil: luminosité des écrans externes (DDC/CI)"
      - "slurp: capture ou enregistrement d'une zone"
      - "wvkbd: clavier virtuel"
      - "fprintd: empreinte digitale au verrouillage"
      - "pavucontrol: réglages du son avancés"
      - "unzip: thèmes au format .zip"
      - "git: plugins depuis un dépôt git"
      - "curl: widget météo d'exemple (hyprdesk.lua)"
      - "kitty: thème des applications (terminal)"
      - "wayle: notifications par wayle (sans lui, hyprdesk les affiche)"

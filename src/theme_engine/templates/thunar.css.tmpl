/* Généré par hyprdesk-theme-engine — pack {{meta.name}} v{{meta.version}} ({{variant}}).
   Réécrit à chaque changement de thème ; importé par gtk.css. Règles limitées
   à Thunar (.thunar) : les autres applications GTK ne changent pas. */

.thunar, .thunar .view, .thunar treeview.view, .thunar iconview, .thunar scrolledwindow {
  background-color: {{palette.bg}};
  color: {{palette.fg}};
}

.thunar .sidebar, .thunar .shortcuts-pane, .thunar placessidebar,
.thunar .sidebar .view, .thunar .shortcuts-pane treeview.view {
  background-color: {{palette.bg|mix(palette.fg 6%)}};
  color: {{palette.fg}};
}

.thunar .view:selected, .thunar treeview.view:selected, .thunar iconview:selected,
.thunar .sidebar .view:selected, .thunar row:selected {
  background-color: {{palette.accent}};
  color: {{palette.bg}};
}

.thunar headerbar, .thunar toolbar, .thunar menubar, .thunar .path-bar,
.thunar .location-bar, .thunar statusbar {
  background-color: {{palette.bg|mix(palette.fg 10%)}};
  color: {{palette.fg}};
}

.thunar statusbar label {
  color: {{palette.fg|mix(palette.bg 35%)}};
}

.thunar entry {
  background-color: {{palette.bg|mix(palette.fg 14%)}};
  color: {{palette.fg}};
  caret-color: {{palette.accent}};
}

.thunar button:hover, .thunar .path-bar button:hover {
  background-color: {{palette.bg|mix(palette.accent 25%)}};
}

.thunar .path-bar button:checked {
  background-color: {{palette.accent}};
  color: {{palette.bg}};
}

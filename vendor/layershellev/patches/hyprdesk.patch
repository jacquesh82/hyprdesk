+//! Glisser-déposer de fichiers vers les surfaces (ajout de hyprdesk) :
+//! `wl_data_device`, offres en `text/uri-list`. Entrée, mouvement, sortie et
+//! dépôt deviennent des `DispatchMessage::Dnd*` ; dès l'entrée, la liste des
+//! fichiers est lue auprès de l'application source, dans un fil à part (délai
+//! borné), pour que la surface sache ce qu'elle survole sans figer le glisser,
+//! puis resservie au dépôt.
+
+use std::collections::HashMap;
+use std::io::Read;
+use std::os::fd::AsFd;
+use std::path::PathBuf;
+use std::sync::mpsc::{self, Receiver, RecvTimeoutError};
+use std::time::Duration;
+
+use wayland_client::backend::ObjectId;
+use wayland_client::protocol::wl_data_device::{self, WlDataDevice};
+use wayland_client::protocol::wl_data_device_manager::{DndAction, WlDataDeviceManager};
+use wayland_client::protocol::wl_data_offer::{self, WlDataOffer};
+use wayland_client::{Connection, Dispatch, Proxy, QueueHandle, delegate_noop};
+
+use crate::WindowState;
+use crate::events::DispatchMessageInner;
+use crate::id;
+
+const URI_LIST: &str = "text/uri-list";
+
+/// Attente de la liste des fichiers à l'entrée : une source prompte allume le
+/// survol aussitôt ; une source lente le fait au mouvement suivant.
+const ENTER_WAIT: Duration = Duration::from_millis(30);
+
+/// Attente de la liste au dépôt, la lecture n'étant pas encore finie.
+const DROP_WAIT: Duration = Duration::from_secs(3);
+
+/// État du glisser-déposer en cours.
+#[derive(Default, Debug)]
+pub struct DndState {
+    pub(crate) device: Option<WlDataDevice>,
+    /// Types annoncés par chaque offre.
+    offers: HashMap<ObjectId, Vec<String>>,
+    current: Option<WlDataOffer>,
+    surface: Option<id::Id>,
+    pos: (f64, f64),
+    /// Lecture en cours des fichiers de l'offre sur la surface. Wayland crée
+    /// une offre à chaque entrée : une lecture par surface survolée.
+    reading: Option<(ObjectId, Receiver<Vec<PathBuf>>)>,
+    /// Fichiers de l'offre sur la surface, une fois lus.
+    paths: Option<(ObjectId, Vec<PathBuf>)>,
+}
+
+impl DndState {
+    /// Fichiers de la lecture en cours, s'ils arrivent dans le délai (une
+    /// seule fois) ; ils restent ensuite dans `paths` pour le dépôt.
+    fn take_read(&mut self, wait: Duration) -> Option<Vec<PathBuf>> {
+        let (_, rx) = self.reading.as_ref()?;
+        let paths = match rx.recv_timeout(wait) {
+            Ok(paths) => paths,
+            Err(RecvTimeoutError::Timeout) => return None,
+            Err(RecvTimeoutError::Disconnected) => Vec::new(),
+        };
+        let (offer, _) = self.reading.take()?;
+        self.paths = Some((offer, paths.clone()));
+        Some(paths)
+    }
+
+    fn forget(&mut self) {
+        self.reading = None;
+        self.paths = None;
+    }
+}
+
+delegate_noop!(@<T> WindowState<T>: ignore WlDataDeviceManager);
+
+impl<T> Dispatch<WlDataOffer, ()> for WindowState<T> {
+    fn event(
+        state: &mut Self,
+        offer: &WlDataOffer,
+        event: wl_data_offer::Event,
+        _data: &(),
+        _conn: &Connection,
+        _qh: &QueueHandle<Self>,
+    ) {
+        if let wl_data_offer::Event::Offer { mime_type } = event {
+            state.dnd.offers.entry(offer.id()).or_default().push(mime_type);
+        }
+    }
+}
+
+impl<T: 'static> Dispatch<WlDataDevice, ()> for WindowState<T> {
+    fn event(
+        state: &mut Self,
+        _device: &WlDataDevice,
+        event: wl_data_device::Event,
+        _data: &(),
+        conn: &Connection,
+        _qh: &QueueHandle<Self>,
+    ) {
+        match event {
+            wl_data_device::Event::DataOffer { id } => {
+                state.dnd.offers.insert(id.id(), Vec::new());
+            }
+            wl_data_device::Event::Enter {
+                serial,
+                surface,
+                x,
+                y,
+                id,
+            } => {
+                let target = state.get_id_from_surface(&surface);
+                state.dnd.surface = target;
+                state.dnd.pos = (x, y);
+                state.dnd.forget();
+                let mut paths = Vec::new();
+                if let Some(offer) = &id {
+                    let files = state
+                        .dnd
+                        .offers
+                        .get(&offer.id())
+                        .is_some_and(|m| m.iter().any(|t| t == URI_LIST));
+                    if files {
+                        if offer.version() >= 3 {
+                            offer.set_actions(DndAction::Copy, DndAction::Copy);
+                        }
+                        offer.accept(serial, Some(URI_LIST.into()));
+                        state.dnd.reading = Some((offer.id(), receive(offer, conn)));
+                        paths = state.dnd.take_read(ENTER_WAIT).unwrap_or_default();
+                    } else {
+                        offer.accept(serial, None);
+                    }
+                }
+                state.dnd.current = id;
+                state
+                    .message
+                    .push((target, DispatchMessageInner::DndEnter { x, y, paths }));
+            }
+            wl_data_device::Event::Motion { x, y, .. } => {
+                state.dnd.pos = (x, y);
+                state
+                    .message
+                    .push((state.dnd.surface, DispatchMessageInner::DndMotion { x, y }));
+                // Liste lue après l'entrée : l'entrée est redite avec ses
+                // fichiers, pour que la surface sache ce qu'elle survole.
+                if let Some(paths) = state.dnd.take_read(Duration::ZERO)
+                    && !paths.is_empty()
+                {
+                    state
+                        .message
+                        .push((state.dnd.surface, DispatchMessageInner::DndEnter { x, y, paths }));
+                }
+            }
+            wl_data_device::Event::Leave => {
+                if let Some(offer) = state.dnd.current.take() {
+                    state.dnd.offers.remove(&offer.id());
+                    offer.destroy();
+                }
+                state.dnd.forget();
+                // Après un dépôt, le compositeur envoie encore `leave` : la
+                // surface, déjà servie, n'a plus de sortie à recevoir.
+                if let Some(target) = state.dnd.surface.take() {
+                    state
+                        .message
+                        .push((Some(target), DispatchMessageInner::DndLeave));
+                }
+            }
+            wl_data_device::Event::Drop => {
+                let Some(offer) = state.dnd.current.take() else {
+                    return;
+                };
+                let files = state
+                    .dnd
+                    .offers
+                    .remove(&offer.id())
+                    .is_some_and(|m| m.iter().any(|t| t == URI_LIST));
+                // La lecture lancée à l'entrée, attendue si elle n'est pas finie.
+                let _ = state.dnd.take_read(DROP_WAIT);
+                let paths = match state.dnd.paths.take() {
+                    Some((o, p)) if files && o == offer.id() => p,
+                    _ => Vec::new(),
+                };
+                state.dnd.forget();
+                if offer.version() >= 3 && files {
+                    offer.finish();
+                }
+                offer.destroy();
+                let (x, y) = state.dnd.pos;
+                state.message.push((
+                    state.dnd.surface.take(),
+                    DispatchMessageInner::DndDrop { x, y, paths },
+                ));
+            }
+            wl_data_device::Event::Selection { id } => {
+                // Presse-papiers : rien à en faire ici ; l'offre précédente est oubliée.
+                if let Some(offer) = id {
+                    state.dnd.offers.remove(&offer.id());
+                }
+            }
+            _ => {}
+        }
+    }
+
+    wayland_client::event_created_child!(WindowState<T>, WlDataDevice, [
+        wl_data_device::EVT_DATA_OFFER_OPCODE => (WlDataOffer, ()),
+    ]);
+}
+
+/// Demande la liste des fichiers à l'application source et la lit dans un
+/// fil à part (3 s au plus par lecture) : la boucle Wayland ne s'y bloque pas.
+fn receive(offer: &WlDataOffer, conn: &Connection) -> Receiver<Vec<PathBuf>> {
+    let (tx, rx) = mpsc::channel();
+    let Ok((mut read, write)) = std::os::unix::net::UnixStream::pair() else {
+        return rx;
+    };
+    offer.receive(URI_LIST.into(), write.as_fd());
+    let _ = conn.flush();
+    drop(write);
+    // Sans fil, l'émetteur tombe avec la fermeture : lecture vide.
+    let _ = std::thread::Builder::new()
+        .name("dnd-uri-list".into())
+        .spawn(move || {
+            let _ = read.set_read_timeout(Some(Duration::from_secs(3)));
+            let mut buf = Vec::new();
+            let _ = read.read_to_end(&mut buf);
+            let _ = tx.send(parse_uri_list(&String::from_utf8_lossy(&buf)));
+        });
+    rx
+}
+
+/// `text/uri-list` → chemins locaux (`file://`, encodage `%XX` décodé).
+pub fn parse_uri_list(s: &str) -> Vec<PathBuf> {
+    s.lines()
+        .map(str::trim)
+        .filter(|l| !l.is_empty() && !l.starts_with('#'))
+        .filter_map(|l| l.strip_prefix("file://"))
+        .map(|rest| {
+            // `file://hote/chemin` : on garde le chemin.
+            let path = if rest.starts_with('/') {
+                rest
+            } else {
+                rest.find('/').map_or(rest, |i| &rest[i..])
+            };
+            PathBuf::from(percent_decode(path))
+        })
+        .collect()
+}
+
+fn percent_decode(s: &str) -> String {
+    let bytes = s.as_bytes();
+    let mut out = Vec::with_capacity(bytes.len());
+    let mut i = 0;
+    while i < bytes.len() {
+        let hex = |c: u8| (c as char).to_digit(16);
+        if bytes[i] == b'%' && i + 2 < bytes.len() {
+            if let (Some(h), Some(l)) = (hex(bytes[i + 1]), hex(bytes[i + 2])) {
+                out.push((h * 16 + l) as u8);
+                i += 3;
+                continue;
+            }
+            out.push(bytes[i]);
+            i += 1;
+        } else {
+            out.push(bytes[i]);
+            i += 1;
+        }
+    }
+    String::from_utf8_lossy(&out).into_owned()
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn liste_d_uri() {
+        let l = parse_uri_list(
+            "# commentaire\r\nfile:///home/moi/Mes%20Images/a.png\r\nfile://hote/tmp/b\nhttps://x\n",
+        );
+        assert_eq!(
+            l,
+            [
+                PathBuf::from("/home/moi/Mes Images/a.png"),
+                PathBuf::from("/tmp/b")
+            ]
+        );
+        assert_eq!(percent_decode("%C3%A9t%C3%A9"), "été");
+        assert_eq!(percent_decode("100%é"), "100%é");
+        assert_eq!(percent_decode("fin%"), "fin%");
+    }
+
+    #[test]
+    fn lecture_servie_une_fois_puis_gardee_pour_le_depot() {
+        let id = wayland_client::backend::Backend::null_id();
+        let mut dnd = DndState::default();
+        let (tx, rx) = mpsc::channel();
+        dnd.reading = Some((id.clone(), rx));
+        // Pas encore lue : rien, la lecture reste en attente.
+        assert_eq!(dnd.take_read(Duration::ZERO), None);
+        assert!(dnd.reading.is_some());
+        tx.send(vec![PathBuf::from("/a.desktop")]).unwrap();
+        assert_eq!(
+            dnd.take_read(Duration::ZERO),
+            Some(vec![PathBuf::from("/a.desktop")])
+        );
+        // Servie une fois ; gardée pour le dépôt.
+        assert_eq!(dnd.take_read(Duration::ZERO), None);
+        assert_eq!(dnd.paths, Some((id.clone(), vec![PathBuf::from("/a.desktop")])));
+        // Fil tombé sans réponse : lecture vide, pas d'attente sans fin.
+        let (tx, rx) = mpsc::channel::<Vec<PathBuf>>();
+        drop(tx);
+        dnd.reading = Some((id, rx));
+        assert_eq!(dnd.take_read(DROP_WAIT), Some(Vec::new()));
+        dnd.forget();
+        assert!(dnd.reading.is_none() && dnd.paths.is_none());
+    }
+}

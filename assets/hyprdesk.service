# Unit systemd user pour hyprdesk — déposée par scripts/install.sh
# (qui précise WAYLAND_DISPLAY détecté).
[Unit]
Description=hyprdesk - bureau à la demande pour Hyprland
PartOf=graphical-session.target
After=graphical-session.target
# Hyprland n'est pas encore là dans les premières secondes de session :
# environ une minute de tentatives avant d'abandonner.
StartLimitIntervalSec=120
StartLimitBurst=20

[Service]
Type=simple
# --replace : le service reprend la main sur une instance lancée à la main
# (une seule instance par session, verrou $XDG_RUNTIME_DIR/hyprdesk.lock).
ExecStart=%h/.local/bin/hyprdesk daemon --replace
Restart=on-failure
RestartSec=3
Slice=session.slice

[Install]
WantedBy=graphical-session.target

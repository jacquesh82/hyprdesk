# Unit systemd user pour hyprdesk — déposée par scripts/install.sh
# (qui précise WAYLAND_DISPLAY détecté).
[Unit]
Description=hyprdesk - bureau à la demande pour Hyprland
PartOf=graphical-session.target
After=graphical-session.target
# Hyprland n'est pas encore là dans les premières secondes de session :
# environ une minute de tentatives avant d'abandonner.
StartLimitIntervalSec=120
StartLimitBurst=20

[Service]
Type=simple
# --replace : le service reprend la main sur une instance lancée à la main
# (une seule instance par session, verrou $XDG_RUNTIME_DIR/hypr/<instance>/hyprdesk.lock).
ExecStart=%h/.local/bin/hyprdesk daemon --replace
# Toujours relancé, sauf arrêt voulu : `systemctl --user stop` (jamais
# relancé par systemd) et `hyprdesk quit`, qui sort avec le code 75, tenu
# pour un succès à ne pas relancer. Une boucle d'affichage terminée sans
# demande, une erreur Wayland ou D-Bus sortent en erreur : relance.
# Surcharges locales : ~/.config/systemd/user/hyprdesk.service.d/*.conf
Restart=always
RestartSec=3
SuccessExitStatus=75
RestartPreventExitStatus=75
Slice=session.slice

[Install]
WantedBy=graphical-session.target
